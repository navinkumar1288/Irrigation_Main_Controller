# Custom ESP-IDF configuration for Arduino sketch
# This file enables MQTT v5 protocol support

# Enable MQTT Protocol v5
CONFIG_MQTT_PROTOCOL_5=y

# MQTT Configuration
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET=y
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=y

# Increase MQTT buffer sizes for better performance
CONFIG_MQTT_BUFFER_SIZE=2048
CONFIG_MQTT_TASK_STACK_SIZE=6144
